# =========================================================================
#                    SHOPDEE FRONTEND ENVIRONMENT CONFIG (TEMPLATE)
# =========================================================================

# -------------------------------------------------------------------------
# 1. API URL CONFIGURATION (Connection to Laravel Backend)
# -------------------------------------------------------------------------

# >>> [LOCAL DEVELOPMENT] - Default local server
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# >>> [PRODUCTION / WEB] - Uncomment and update with your web domain when deploying
# NEXT_PUBLIC_API_URL=https://your-production-backend-domain.com/api


# -------------------------------------------------------------------------
# 2. REALTIME CHAT CONFIGURATION (Laravel Reverb or Pusher Cloud)
# -------------------------------------------------------------------------

# >>> [LOCAL DEVELOPMENT] - Connects to local Laravel Reverb WebSocket
NEXT_PUBLIC_PUSHER_APP_KEY=shopdee_key
NEXT_PUBLIC_PUSHER_APP_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_HOST=127.0.0.1
NEXT_PUBLIC_PUSHER_PORT=8080
NEXT_PUBLIC_PUSHER_SCHEME=http

# >>> [PRODUCTION / WEB] - Use when deploying to web (Pusher Cloud)
# NEXT_PUBLIC_PUSHER_APP_KEY=your_production_pusher_key
# NEXT_PUBLIC_PUSHER_APP_CLUSTER=ap1
# NEXT_PUBLIC_PUSHER_HOST=
# NEXT_PUBLIC_PUSHER_PORT=
# NEXT_PUBLIC_PUSHER_SCHEME=https


# -------------------------------------------------------------------------
# 3. GOOGLE LOGIN CONFIGURATION (Google OAuth Client ID)
# -------------------------------------------------------------------------

# Shared between local and web environments (Replace with your actual Client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
