# =========================================================================
#                    SHOPDEE BACKEND ENVIRONMENT CONFIG (TEMPLATE)
# =========================================================================

# -------------------------------------------------------------------------
# 1. GENERAL APP SETTINGS
# -------------------------------------------------------------------------
APP_NAME=ShopDee
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

# -------------------------------------------------------------------------
# 2. URL & DOMAIN CONFIGURATION
# -------------------------------------------------------------------------

# >>> [LOCAL DEVELOPMENT] - Default local server mappings
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# >>> [PRODUCTION / WEB] - Uncomment and update with your domains when deploying to web
# APP_URL=https://your-production-backend-domain.com
# FRONTEND_URL=https://your-production-frontend-domain.com
# SESSION_DOMAIN=.your-domain.com
# SANCTUM_STATEFUL_DOMAINS=your-domain.com,api.your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-production-frontend-domain.com


# -------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# -------------------------------------------------------------------------

# >>> [LOCAL DEVELOPMENT] - Local MySQL database (e.g. XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopdee
DB_USERNAME=root
DB_PASSWORD=

# >>> [PRODUCTION / WEB] - Remote database (e.g. Supabase, AWS RDS, etc.)
# DB_CONNECTION=pgsql
# DB_HOST=your-production-database-host.com
# DB_PORT=5432
# DB_DATABASE=your_database_name
# DB_USERNAME=your_database_username
# DB_PASSWORD=your_database_password


# -------------------------------------------------------------------------
# 4. REALTIME CHAT CONFIGURATION (Broadcast / WebSocket)
# -------------------------------------------------------------------------

# >>> [LOCAL DEVELOPMENT] - Default local Laravel Reverb
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=123456
REVERB_APP_KEY=shopdee_key
REVERB_APP_SECRET=shopdee_secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# >>> [PRODUCTION / WEB] - Use when deploying to web (Pusher Cloud)
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=your_pusher_app_id
# PUSHER_APP_KEY=your_pusher_key
# PUSHER_APP_SECRET=your_pusher_secret
# PUSHER_APP_CLUSTER=ap1


# -------------------------------------------------------------------------
# 5. STORAGE CONFIGURATION (File Storage & Uploads)
# -------------------------------------------------------------------------

# >>> [LOCAL DEVELOPMENT] - Local public folder
FILESYSTEM_DISK=public

# >>> [PRODUCTION / WEB] - Cloud image hosting (e.g. Cloudinary)
# FILESYSTEM_DISK=cloudinary
# CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# -------------------------------------------------------------------------
# 6. GOOGLE LOGIN CONFIGURATION (Google OAuth Client ID & Secret)
# -------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# >>> [LOCAL DEVELOPMENT]
GOOGLE_REDIRECT_URL=http://localhost:8000/api/auth/google/callback

# >>> [PRODUCTION / WEB] - Callback URL on production web
# GOOGLE_REDIRECT_URL=https://your-production-backend-domain.com/api/auth/google/callback


# -------------------------------------------------------------------------
# 7. EMAIL CONFIGURATION (Mail Settings - SMTP)
# -------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"


# -------------------------------------------------------------------------
# 8. AI ENGINE CONFIGURATION (AI Microservice Connection)
# -------------------------------------------------------------------------

# >>> [LOCAL DEVELOPMENT] - Local Python API server
AI_API_URL=http://localhost:5000

# >>> [PRODUCTION / WEB] - Deploy AI service to web
# AI_API_URL=https://your-production-ai-domain.com